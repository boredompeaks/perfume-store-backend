# Environment template — copy to .env and fill in. NEVER commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# V-02: DEBUG fails CLOSED — an absent DJANGO_DEBUG means DEBUG=false, so
# an unconfigured deployment boots into the hardened configuration (and is
# refused without a real DJANGO_SECRET_KEY). Set DJANGO_DEBUG=true only
# for local development.
DJANGO_DEBUG=false
# SPEC-22-03 [R-22.3]: the environment this deployment IS: local, ci,
# staging or production. Required whenever DJANGO_DEBUG=false (an
# environment that cannot be named cannot be isolated from the others) and
# an unknown value is refused at boot rather than guessed at. Development may
# leave it unset. Isolation is per environment: one database and one
# DJANGO_SECRET_KEY each, so a staging run can never touch production data.
DJANGO_ENV=production
# Non-debug boots must state their hosts and origins explicitly - the
# localhost development defaults below are never a deployed configuration.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Logging (SPEC-7-02). LOG_LEVEL sets the app log level (DEBUG, INFO,
# WARNING, ERROR, CRITICAL); unknown values fall back to INFO with a
# warning. Request 5xx are always visible at ERROR, and the audit trail is
# pinned at INFO so it stays observable even when the app level is raised.
# LOG_FILE (optional) adds a rotating file handler (5 MB x 3 backups) at
# the given path; leave it unset for console-only output, which is safe on
# read-only filesystems (logs stream to stdout for the platform to collect).
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# Database (DATABASE_URL). PostgreSQL in production, sqlite for local dev.
# Supported schemes:
#   postgres:// or postgresql://  — user/password/host/port and db name are
#     mapped from the URL (URL-escaped characters are decoded).
#   sqlite:///relative/path.sqlite3  — relative to the backend/ directory;
#     sqlite:////absolute/path.sqlite3 (four slashes) or sqlite:///C:/path
#     name an absolute file.
# Anything missing, malformed, or unsupported (e.g. mysql://) falls back to
# the sqlite dev database at backend/db.sqlite3 when DJANGO_DEBUG=true (local
# development). With DJANGO_DEBUG=false that fallback is REFUSED and the app
# names the problem instead of booting: a production or staging host on
# developer data is worse than a failed boot (SPEC-22-03 [R-22.3]). An
# explicit sqlite:// URL is honoured in any environment - it is a deliberate
# choice, not a silent substitution.
# Query params become the Postgres connection OPTIONS, so a remote managed
# database MUST carry its TLS setting in the URL:
#   ?sslmode=require  (or verify-ca / verify-full)
# Local dev default (leave commented out to keep sqlite):
# DATABASE_URL=postgres://user:password@localhost:5432/perfume_store
# DATABASE_URL=postgres://user:password@db.example.com:5432/perfume_store?sslmode=require
# DATABASE_URL=sqlite:///db.sqlite3

# Backups (SPEC-22-02 [R-22.9]). `manage.py backup_db` dumps the database
# configured above and then keeps the newest BACKUP_RETENTION dumps; the
# schedule and the restore procedure are in docs/deploy-runbook.md
# ("Backups") and docs/runbook-incident-recovery.md.
# BACKUP_DIR: REQUIRED for a backup run - the directory the dumps are written
# to. A run without it is refused by name, because a dump written into a
# container's writable layer is lost when the container is replaced. In .env
# this is a HOST path: scripts/backup.sh bind-mounts it into the one-shot
# container, so a bare `docker compose run ... backup_db` is not how you take
# a backup (it would create the host path inside a throwaway container).
# BACKUP_DIR=/srv/perfume-store/backups
# BACKUP_RETENTION: how many dumps to keep, newest first (default 7; a
# non-numeric value falls back to the default). A count below 1 is refused.
# BACKUP_RETENTION=7

# Static files. DJANGO_STATIC_ROOT is where `manage.py collectstatic`
# gathers assets; whitenoise then serves them from the app process, so
# DEBUG=false deployments need no separate web server or object store.
# Unset it and assets land in backend/staticfiles (the default the
# container image also uses); override it when the volume layout differs.
# DJANGO_STATIC_ROOT=/app/staticfiles

# Media (SPEC-2-04 [V-13]) — UPLOADS (product images, staff/user files) are
# media, not static, and must survive a container restart: leave it unset
# locally (files land in backend/media) and point it at the mounted volume in
# production, e.g. DJANGO_MEDIA_ROOT=/app/media with the volume mounted there
# (docker-compose.yml already mounts media_data at /app/media). A media file
# that is not on a persistent volume is a lost upload once the container is
# replaced.
# DJANGO_MEDIA_ROOT=/app/media
# The storage backend is switchable by configuration (settings.STORAGES), so
# uploads can move off the app filesystem later without a code change. The
# default is the local filesystem rooted at DJANGO_MEDIA_ROOT; any installable
# dotted Python path works (an object-store backend, when one is wanted), and
# a value that is not a dotted path is refused at boot rather than on the
# first upload.
# DJANGO_MEDIA_BACKEND=django.core.files.storage.FileSystemStorage
# Front door: nginx (or the platform's CDN) should serve /media/ directly
# from the same volume; Django also serves it (config/urls.py) so a missing
# front-door rule degrades to a served file rather than a 404. See
# docs/deploy-runbook.md ("Serving media").

# CORS / CSRF (comma-separated). CSRF_TRUSTED_ORIGINS must be set explicitly
# outside development too (SPEC-22-03 [R-22.3]); leave the value below only
# for local work.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Razorpay (rotate any key that has ever been committed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (SPEC-1-06): the value Razorpay signs each delivery with,
# from Dashboard -> Settings -> Webhooks -> the secret beside the endpoint URL
# (https://<host>/api/v1/webhooks/razorpay/). Separate from the key pair above
# - rotating one does not rotate the other. Leave empty and the endpoint
# answers 503 for every delivery (it never accepts an unsigned one).
RAZORPAY_WEBHOOK_SECRET=

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Throttle rates for public endpoints ("requests/period",
# period: s/sec/m/min/h/hour/d/day). coupon = apply-coupon preview,
# cart = cart add/update/remove, auth = register + login + verify-email +
# password-reset confirm + username-available + token refresh,
# recovery = email-sending flows (resend verification, forgot username,
# password reset) - tighter because each request sends an email.
# payment = payment intent minting (create_payment) - each accepted
# request calls the gateway and writes a payment event.
# restock = SPEC-19-4 back-in-stock opt-in/opt-out - each opt-in is intent
# to receive an outbound email, so it gets the recovery-shaped budget.
# webhook = SPEC-1-06 payment webhook deliveries - server-to-server, arrive
# in bursts, so the budget bounds parsing work and honest traffic, not
# credential guessing (the signature is what defends that endpoint).
THROTTLE_COUPON_RATE=10/min
THROTTLE_CART_RATE=60/min
THROTTLE_AUTH_RATE=10/min
THROTTLE_RECOVERY_RATE=5/min
PAYMENT_THROTTLE_RATE=10/min
THROTTLE_RESTOCK_RATE=5/min
THROTTLE_WEBHOOK_RATE=120/min

# Ops dashboard / /health/: products with stock at or below this many units
# are flagged as "low stock" (health check + admin dashboard table).
# Non-integer values are ignored and the default is used instead.
LOW_STOCK_THRESHOLD=5

# Ops dashboard "Sales over time" chart: trailing window in calendar days
# ending today. Non-integer values are ignored and the default is used instead.
DASHBOARD_SALES_WINDOW_DAYS=30

# SPEC-19-2 Admin alerts (low stock, out of stock, payment-failure spikes,
# security-sensitive account changes, integration outages). ALERT_RECIPIENTS
# is a comma-separated list of staff mailboxes; leave it EMPTY to disable
# admin alerts entirely (nothing is sent, triggers stay no-ops).
ALERT_RECIPIENTS=
# Per-alert-type dedupe: an alert type that already sent within this many
# seconds is logged instead of re-sent (protects the inbox from the
# pollable /health/ and dashboard triggers). Non-integer values are ignored
# and the default is used instead.
ALERT_COOLDOWN_SECONDS=300
# Payment-failure spike rule: at least PAYMENT_FAILURE_SPIKE_COUNT failed
# payment attempts within the trailing PAYMENT_FAILURE_SPIKE_WINDOW_SECONDS
# seconds fires one spike alert (then the cooldown applies).
PAYMENT_FAILURE_SPIKE_COUNT=3
PAYMENT_FAILURE_SPIKE_WINDOW_SECONDS=300

# Storefront products listing: rows per page. The historical hardcoded 2 was
# a dev/test artifact (F-23); 12 is a storefront-appropriate default.
# Non-integer values are ignored and the default is used instead.
PRODUCTS_PAGE_SIZE=12

# [R-21.2.6] Duplicate checkout submissions (double-click / client retry)
# within this many seconds collapse onto the still-payable pending order
# with the identical payload, instead of creating a second order. The guard
# only closes the accidental window; header-keyed idempotency is SPEC-9-01.
# Non-integer values are ignored and the default is used instead.
CHECKOUT_DEDUP_WINDOW_SECONDS=300

# Error tracking (SPEC-22-04 [R-22.13]) — OPTIONAL and inert without a DSN.
# SENTRY_DSN is the tracker project's ingest DSN. Leave it UNSET and the app
# never imports the SDK, never initialises anything and never makes an
# outbound call: local development, CI and the test suite are unaffected. Set
# it in production and unhandled exceptions plus the django.request 5xx
# records the app already logs (SPEC-7-02 pins that channel at ERROR) are
# reported to the project named by the DSN.
# The DSN carries a public ingest key, so it is still configuration, not a
# secret to commit: it lives in this .env / the repo-root .env / your
# platform's secret store, never in the repository.
# SENTRY_ENVIRONMENT labels the events. Defaults to DJANGO_ENV (local | ci |
# staging | production), so a staging error is never filed as a production
# one; set it only to override that (e.g. a canary release sharing the
# production DSN).
# SENTRY_SAMPLE_RATE is the fraction of error events kept, 0.0-1.0 (default
# 1.0 — every event). Lower it on a noisy deployment; it is a float and a
# non-numeric or out-of-range value falls back to the default with a warning.
# SENTRY_TRACES_SAMPLE_RATE is the performance/tracing fraction (default 0.0,
# off): this app instruments no transactions, so a non-zero value would bill
# for telemetry nothing consumes. The SDK is pinned in requirements.txt and
# is imported ONLY when a DSN is set.
# SENTRY_DSN=https://<public-key>@<ingest-host>/<project-id>
# SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=0.0

# SPEC-9-04 Customer order-history listing (GET /api/orders/): rows per
# page, and the ceiling a ?page_size caller may request. Non-integer values
# are ignored and the defaults are used instead.
ORDER_HISTORY_PAGE_SIZE=10
ORDER_HISTORY_MAX_PAGE_SIZE=100

# SPEC-1-B07b [R-1.16] Customer returns listing (GET /api/orders/returns/): rows
# per page, and the ceiling a ?page_size caller may request. A SEPARATE pair
# rather than reusing ORDER_HISTORY_*: the store may want a denser returns page
# than order page, and one knob for both would force that choice. Non-integer
# values are ignored and the defaults are used instead.
#
# There is deliberately NO return-window key here. Spec 4 line 1083 ("Return/
# refund request where eligible") and spec 6.8 line 1959 ("Eligibility
# validation") both describe a window the specification never gives a number for
# - a whole-file sweep for a day count finds one hit and it is about deployment
# cadence, not returns. Eligibility is therefore derived from the order machine's
# own payment/fulfilment dimensions and an order's AGE IS NOT AN INPUT to it. If
# a deployment does want a return window, add its key here with its own
# documented default; do not introduce the number in code.
RETURNS_HISTORY_PAGE_SIZE=10
RETURNS_HISTORY_MAX_PAGE_SIZE=100

# SPEC-12-01 Inventory reservation: how many seconds a checkout's stock
# reservation holds units before it goes stale and the reconciliation
# command (expire_reservations) releases them back to the sellable pool.
# Coordinate with the payment window (Razorpay checkout session) so a
# customer can always finish paying inside the hold. Non-integer values
# are ignored and the default is used instead.
RESERVATION_TTL=900

# SPEC-1-B05 [R-1.07] Free-shipping rule (spec 6.9). When set, an order whose
# MERCHANDISE total (cart subtotal after discount, before shipping) reaches
# this amount is charged nothing for delivery; below it, the rate that matches
# the destination is charged. Leave it EMPTY (the default) to switch the rule
# off and always charge the configured rate.
#
# DANGER: 0 is NOT the same as empty. SHIPPING_FREE_THRESHOLD=0 turns the
# rule ON at zero, so EVERY shipment is free, for every order, forever - the
# store collects no delivery revenue at all and nothing errors. To switch the
# rule off you must leave the value EMPTY, not set it to 0.
#
# A money amount in the store currency, read as a Decimal. Anything that is
# not a usable non-negative money amount is ignored with a warning and the
# rule is left OFF (i.e. always charged), so a typo here can never take the
# app down or make every shipment free. That covers unparseable text, a
# negative amount, the non-finite values NaN/Infinity, and a value above
# 99999999.99 (the largest amount this store's money columns can hold).
# Shipping RATES themselves are not env config: they are staff-managed rows
# (ShippingMethod/ShippingRate, admin -> Shipping), because they change per
# geography far more often than a deployment changes its env. A store with no
# active method is reported as shipping_configured=false on /health/, warned
# about on every checkout, and can be seeded with
# `python manage.py seed_shipping_methods`.
SHIPPING_FREE_THRESHOLD=

# SPEC-12-03 Reconciliation cadence: schedule `python manage.py
# expire_reservations` well inside RESERVATION_TTL (e.g. every minute via
# cron or celery-beat; the scheduler wiring itself belongs to the
# background-jobs/deployment work, S19/S22). Coordination rules with the
# payment provider: the TTL must exceed the Razorpay checkout-session
# window (a customer must be able to finish paying inside the hold), and
# the sweep cadence must be shorter than the TTL so stale holds clear
# promptly. The sweep reclaims the reservation book only — payment truth
# (webhook/timeout reconciliation, SPEC-1-06/SPEC-1-18) is never touched,
# and a late verify of a swept checkout still lands on verify_payment's
# re-checked stock (SPEC-12-02).

# [R-8.11] Store currency for every money column (orders, order items).
# New orders/items record this ISO 4217 code beside their amounts and the
# payment gateway is charged in it. Must be exactly three letters
# (case-insensitive); an invalid value falls back to INR with a warning.
# Changing it affects NEW orders only — existing rows keep the currency
# they were minted with (the 0008 migration backfilled all pre-existing
# rows to INR, so historical data stays deterministic).
DEFAULT_CURRENCY=INR

# SPEC-17-01 JWT lifetimes, in integer seconds. The access token is a
# short-lived bearer credential (default 900 = 15 minutes); the refresh
# token outlives it (default 604800 = 7 days) and ROTATES on every use
# with blacklist-after-rotation, so a leaked refresh token cannot be
# replayed and password reset/logout revoke outstanding sessions.
# Coordinate the pair: the refresh window bounds how long a customer can
# stay signed in without re-authenticating; the access window bounds how
# long a stolen bearer credential is usable. Non-integer values fall back
# to the documented defaults.
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=604800

# SPEC-17-02 refresh-token cookie. The refresh token never enters the JSON
# response body (or browser localStorage); it rides an HttpOnly cookie set
# on login and re-set on every rotation. NAME/PATH/SAMESITE are env-driven;
# Secure is added automatically whenever DEBUG is false. Keep PATH covering
# the API surface (accounts routes mount at /api/accounts/ and
# /api/v1/account/). SAMESITE=Lax blocks cross-site attachment on POSTs
# (refresh/logout are POST-only) while matching the same-site frontend/API
# deployment constraint; tighten to Strict only after verifying no
# navigation flow depends on the cookie.
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_PATH=/api/
JWT_REFRESH_COOKIE_SAMESITE=Lax

# SPEC-17-03 CSRF for session-cookie cart/checkout mutations. The session
# cookie carries the cart identity, so its SameSite policy is explicit
# here: Lax matches the refresh cookie's reading (cross-site POSTs cannot
# attach it). This is the same-site belt — the actual gate is server-side
# (SessionCartCSRFAuthentication): unsafe requests that ride the session
# cookie must replay the csrftoken cookie (issued by GET /api/cart/) as
# X-CSRFToken, which the SPA does automatically. JWT-bearer requests are
# never gated. CSRF_TRUSTED_ORIGINS above must list the deployed storefront
# origin for HTTPS Referer/Origin checking.
SESSION_COOKIE_SAMESITE=Lax

# SPEC-17-07 Transport/cookie hardening, ENABLED in the deployment path by
# SPEC-22-08 [R-22.6]: docker-compose.yml sets these with production
# defaults, so a compose deployment gets HTTPS-only redirects and a one-year
# HSTS window without anyone editing a file. The defaults written HERE are the
# development-safe ones (settings.py keeps them, and DJANGO_DEBUG=true never
# gets the hardening on), because this file is what a developer copies for a
# plain-HTTP local run. Every key below is a pass-through in compose, so the
# repo-root .env overrides any of it: a plain-HTTP local `docker compose up`
# must set SECURE_SSL_REDIRECT=false and SECURE_HSTS_SECONDS=0. All flags are
# env-gated; enable them together with real TLS:
#   SECURE_HSTS_SECONDS       0 disables the HSTS header entirely (safe
#                             default; a non-zero value like 31536000 tells
#                             browsers to refuse plain HTTP for that long
#                             - only once the host is fully HTTPS).
#   SECURE_HSTS_INCLUDE_SUBDOMAINS / SECURE_HSTS_PRELOAD
#                             only with HSTS enabled, and only once EVERY
#                             subdomain is HTTPS-safe (preload is
#                             effectively irreversible).
#   SECURE_SSL_REDIRECT       redirect plain-HTTP requests to HTTPS; off
#                             locally so dev and tests keep working.
#   SECURE_PROXY_SSL_HEADER_NAME/_VALUE
#                             the forwarded-scheme header the TLS-terminating
#                             proxy sends, as the WSGI environ NAME Django
#                             actually looks up (request.META[header]): the
#                             wire header X-Forwarded-Proto arrives as
#                             HTTP_X_FORWARDED_PROTO, so the name is that,
#                             not "X-Forwarded-Proto" (a bare header name
#                             never matches and every proxied request looks
#                             like plain HTTP, which loops the SSL redirect).
#                             BOTH parts must be set to take effect, and only
#                             from a proxy that sets the header on every
#                             request and overwrites any client-supplied copy
#                             (a forgeable pair lets a client lie about its
#                             scheme). Leave unset otherwise.
# SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE default to "Secure whenever
# DEBUG is false", matching the JWT refresh cookie's secure=not-DEBUG
# contract, so the three auth cookies never disagree about transport
# security; set them explicitly only to force an override.
# What docker-compose.yml actually sets for a compose deployment:
#   SECURE_SSL_REDIRECT=true  SECURE_HSTS_SECONDS=31536000
#   SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
#   SECURE_PROXY_SSL_HEADER_VALUE=https
SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
# SECURE_SSL_REDIRECT=false
# SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# SECURE_PROXY_SSL_HEADER_VALUE=https

# SPEC-17-08 [R-17.21] Product image upload ceiling, in whole MB. Enforced
# on every upload surface (the staff API product create/update and the
# admin product form) with a 400 validation error; oversize uploads are
# rejected before any bytes are written to storage. If you raise this,
# also raise the web server's own request-body limit (it fires first and
# answers with its own 413). Non-integer values fall back to the default.
MAX_UPLOAD_MB=5

# Frontend base URL used in verification/reset links and order-confirmation emails
FRONTEND_URL=http://localhost:3000
# SPEC-20-13: the enrollment page the admin login page links to when
# mandatory MFA (R-17.9) blocks an unenrolled privileged account. Defaults
# to $FRONTEND_URL/staff/mfa/enroll; set it only when the storefront and
# the API/admin are served from different origins.
#MFA_ENROLL_URL=http://localhost:3000/staff/mfa/enroll

# SPEC-20-8 "trust this device for N days" on the privileged MFA door
# (opt-in, per browser; a privileged staff member asks for it once and is not
# challenged on that device until it lapses). Days the grant lasts after the
# user explicitly asks for it. Set to 0 to put every privileged login back
# behind a fresh code — the emergency kill switch. Defaults to 30.
#MFA_TRUST_DAYS=30
# Name of the HttpOnly signed marker that binds a trusted device to the
# browser that asked for it; override only to keep it apart from another
# cookie on the same host.
#MFA_TRUST_COOKIE_NAME=mfa_trusted_device
# Sent on same-site requests only; 'Strict' is the safe default and is what
# keeps the marker off cross-site navigations.
#MFA_TRUST_COOKIE_SAMESITE=Strict
