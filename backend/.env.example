# Environment template — copy to .env and fill in. NEVER commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Razorpay (rotate any key that has ever been committed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Throttle rates for public mutating endpoints ("requests/period",
# period: s/sec/m/min/h/hour/d/day). coupon = apply-coupon preview,
# cart = cart add/update/remove, auth = register + login.
THROTTLE_COUPON_RATE=10/min
THROTTLE_CART_RATE=60/min
THROTTLE_AUTH_RATE=10/min

# Frontend base URL used in verification/reset links
FRONTEND_URL=http://localhost:3000
