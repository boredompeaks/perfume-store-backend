# Environment template — copy to .env and fill in. NEVER commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# V-02: DEBUG fails CLOSED — an absent DJANGO_DEBUG means DEBUG=false, so
# an unconfigured deployment boots into the hardened configuration (and is
# refused without a real DJANGO_SECRET_KEY). Set DJANGO_DEBUG=true only
# for local development.
DJANGO_DEBUG=false
# SPEC-22-03 [R-22.3]: the environment this deployment IS: local, ci,
# staging or production. Required whenever DJANGO_DEBUG=false (an
# environment that cannot be named cannot be isolated from the others) and
# an unknown value is refused at boot rather than guessed at. Development may
# leave it unset. Isolation is per environment: one database and one
# DJANGO_SECRET_KEY each, so a staging run can never touch production data.
DJANGO_ENV=production
# Non-debug boots must state their hosts and origins explicitly - the
# localhost development defaults below are never a deployed configuration.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Logging (SPEC-7-02). LOG_LEVEL sets the app log level (DEBUG, INFO,
# WARNING, ERROR, CRITICAL); unknown values fall back to INFO with a
# warning. Request 5xx are always visible at ERROR, and the audit trail is
# pinned at INFO so it stays observable even when the app level is raised.
# LOG_FILE (optional) adds a rotating file handler (5 MB x 3 backups) at
# the given path; leave it unset for console-only output, which is safe on
# read-only filesystems (logs stream to stdout for the platform to collect).
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# Database (DATABASE_URL). PostgreSQL in production, sqlite for local dev.
# Supported schemes:
#   postgres:// or postgresql://  — user/password/host/port and db name are
#     mapped from the URL (URL-escaped characters are decoded).
#   sqlite:///relative/path.sqlite3  — relative to the backend/ directory;
#     sqlite:////absolute/path.sqlite3 (four slashes) or sqlite:///C:/path
#     name an absolute file.
# Anything missing, malformed, or unsupported (e.g. mysql://) falls back to
# the sqlite dev database at backend/db.sqlite3 when DJANGO_DEBUG=true (local
# development). With DJANGO_DEBUG=false that fallback is REFUSED and the app
# names the problem instead of booting: a production or staging host on
# developer data is worse than a failed boot (SPEC-22-03 [R-22.3]). An
# explicit sqlite:// URL is honoured in any environment - it is a deliberate
# choice, not a silent substitution.
# Query params become the Postgres connection OPTIONS, so a remote managed
# database MUST carry its TLS setting in the URL:
#   ?sslmode=require  (or verify-ca / verify-full)
# Local dev default (leave commented out to keep sqlite):
# DATABASE_URL=postgres://user:password@localhost:5432/perfume_store
# DATABASE_URL=postgres://user:password@db.example.com:5432/perfume_store?sslmode=require
# DATABASE_URL=sqlite:///db.sqlite3

# Backups (SPEC-22-02 [R-22.9]). `manage.py backup_db` dumps the database
# configured above and then keeps the newest BACKUP_RETENTION dumps; the
# schedule and the restore procedure are in docs/deploy-runbook.md
# ("Backups") and docs/runbook-incident-recovery.md.
# BACKUP_DIR: REQUIRED for a backup run - the directory the dumps are written
# to. A run without it is refused by name, because a dump written into a
# container's writable layer is lost when the container is replaced. In .env
# this is a HOST path: scripts/backup.sh bind-mounts it into the one-shot
# container, so a bare `docker compose run ... backup_db` is not how you take
# a backup (it would create the host path inside a throwaway container).
# BACKUP_DIR=/srv/perfume-store/backups
# BACKUP_RETENTION: how many dumps to keep, newest first (default 7; a
# non-numeric value falls back to the default). A count below 1 is refused.
# BACKUP_RETENTION=7

# Static files. DJANGO_STATIC_ROOT is where `manage.py collectstatic`
# gathers assets; whitenoise then serves them from the app process, so
# DEBUG=false deployments need no separate web server or object store.
# Unset it and assets land in backend/staticfiles (the default the
# container image also uses); override it when the volume layout differs.
# DJANGO_STATIC_ROOT=/app/staticfiles

# Media (SPEC-2-04 [V-13]) — UPLOADS (product images, staff/user files) are
# media, not static, and must survive a container restart: leave it unset
# locally (files land in backend/media) and point it at the mounted volume in
# production, e.g. DJANGO_MEDIA_ROOT=/app/media with the volume mounted there
# (docker-compose.yml already mounts media_data at /app/media). A media file
# that is not on a persistent volume is a lost upload once the container is
# replaced.
# DJANGO_MEDIA_ROOT=/app/media
# The storage backend is switchable by configuration (settings.STORAGES), so
# uploads can move off the app filesystem without a code change. The default
# is the local filesystem rooted at DJANGO_MEDIA_ROOT; any installable
# dotted Python path works, and a value that is not a dotted path is refused
# at boot rather than on the first upload.
# DJANGO_MEDIA_BACKEND=django.core.files.storage.FileSystemStorage
#
# S3-compatible OBJECT STORAGE for uploads (TIER1-S3-MEDIA): one
# implementation covers the preferred provider (Cloudflare R2) and the
# alternative (AWS S3) - django-storages' S3Storage, selected by setting
# DJANGO_MEDIA_BACKEND to storages.backends.s3.S3Storage. R2 is
# S3-compatible, so the difference between the two providers is ONE value,
# AWS_S3_ENDPOINT_URL. Everything below is per-deployment configuration
# that lives in your environment or secret store, NEVER in this repository
# (white-label: no bucket name, credential or endpoint is written into the
# source or this file).
#   AWS_STORAGE_BUCKET_NAME  REQUIRED once the S3 backend is selected; the
#     app refuses to boot without it rather than failing on the first
#     upload in production.
#   AWS_S3_ENDPOINT_URL  the provider's S3 API endpoint. Set it for
#     Cloudflare R2 (or any other S3-compatible service); leave it UNSET
#     to talk to AWS S3 itself.
#   AWS_S3_REGION_NAME  the bucket's region; unset lets the provider
#     default apply.
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  a credential for the
#     bucket. Leave both unset to fall back to boto3's own chain (shared
#     config files, instance/task roles) - an IAM-role deployment needs
#     neither key here.
#   AWS_S3_CUSTOM_DOMAIN  optional CDN or custom domain in front of the
#     bucket; storage.url() then returns URLs under that domain.
# Collision behaviour matches the local-filesystem default: a second
# upload under an existing name is stored with a suffixed key, never a
# silent overwrite.
# DJANGO_MEDIA_BACKEND=storages.backends.s3.S3Storage
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=
# Front door: nginx (or the platform's CDN) should serve /media/ directly
# from the same volume; Django also serves it (config/urls.py) so a missing
# front-door rule degrades to a served file rather than a 404. See
# docs/deploy-runbook.md ("Serving media").

# CORS / CSRF (comma-separated). Both loopback spellings are listed because
# the storefront must be reachable at either one (the browser's API origin
# follows the page host). CSRF_TRUSTED_ORIGINS must be set explicitly outside
# development too (SPEC-22-03 [R-22.3]); leave the values below only for
# local work.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay (rotate any key that has ever been committed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (SPEC-1-06): the value Razorpay signs each delivery with,
# from Dashboard -> Settings -> Webhooks -> the secret beside the endpoint URL
# (https://<host>/api/v1/webhooks/razorpay/). Separate from the key pair above
# - rotating one does not rotate the other. Leave empty and the endpoint
# answers 503 for every delivery (it never accepts an unsigned one).
RAZORPAY_WEBHOOK_SECRET=
# Seconds the refund seam will WAIT on Razorpay's socket before giving up.
# The refund is requested from inside the caller's transaction, holding the
# order's row lock, so a gateway that accepts the connection and then stalls
# parks every other refund for that order behind it - a money-blocking
# outage, not a slow request. When it trips the attempt rolls back whole and
# the operator sees the gateway error, exactly like any other declined
# refund. 10 is several times what a healthy gateway needs; raise it only for
# a genuinely slow one.
# A non-integer value, or one below 1, is ignored with a warning and 10 is
# used instead.
RAZORPAY_TIMEOUT=10

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds the app will WAIT on the mail server's socket, for the whole SMTP
# conversation (connect, handshake, DATA). Unset means Django's own default,
# None - a socket with no timeout at all - so a provider that accepts the
# connection and then stalls holds the request open FOREVER. Every send here
# is inline and pre-commit, inside the caller's transaction (the order
# confirmation even holds row locks while it waits), so an unbounded wait is
# a checkout-blocking outage, not a slow request. 10 is several times what a
# healthy relay needs and still a bounded failure; raise it only for a
# genuinely slow relay, and know that a tripped timeout surfaces as the
# documented 503 on the four recovery/registration endpoints, and as a
# log-and-continue on the order-confirmation and staff-alert paths.
# A non-integer value, or one below 1, is ignored with a warning and 10 is
# used instead (0 would put the socket in non-blocking mode, which fails
# every send far from the cause).
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=

# Seconds a queued notification row (the durable outbox) may sit before the
# purge command treats it as spent and deletes it. The outbox payload is NOT
# run through the audit trail's credential-field scrubber, because a reset or
# verification notification is built out of exactly the one-time token
# material that scrubber drops - dropping it would break the mail. So a queued
# payload can hold live token material, and the control for that is deletion
# on a clock rather than redaction at write time. Run the deletion owner as
# often as this bound allows: `manage.py purge_notification_outbox`. The
# default is three days - longer than any mail backlog, short enough that a
# stranded row does not outlive the reason it was queued. A non-integer value,
# or one below 1, is ignored with a warning and the default is used.
NOTIFICATION_OUTBOX_TTL_SECONDS=259200

# --- Notification outbox drain (spec 19.3 background job requirements) -------
#
# The outbox is only durable once something drains it. Celery beat does that
# now (see CELERY_BEAT_DRAIN_OUTBOX_SECONDS below): start the two processes and
# the drain, the purge and the reservation sweep all run on their own:
#
#   celery -A config worker -l info
#   celery -A config beat   -l info
#
# The cron form below remains valid and is still the right answer on a host
# that runs no worker at all - the tasks call exactly the same commands:
#
#   * * * * *  manage.py drain_notification_outbox --verbosity 0
#   17 3 * * *  manage.py purge_notification_outbox --verbosity 0
#
# Pick ONE. Running both drains the queue twice per tick; it is safe (a row is
# claimed under a row lock, and its send state is re-checked under that lock,
# so a second pass skips rows the first is holding) but it buys nothing.
#
# Run interval vs backoff below: the effective wait for a failed row is the
# backoff PLUS up to one run interval, so pick an interval that suits the wait
# you are willing to promise. That is why the beat cadence for the drain is
# every minute rather than every five: a five-minute tick would add five
# minutes to a retry's first wait.

# Ceiling on rows one drain pass claims. The pass stops as soon as nothing is
# claimable, so this bounds a backlog, not a runtime.
NOTIFICATION_OUTBOX_DRAIN_BATCH_SIZE=100

# How long a claimed row is out of other workers' reach, in seconds. MUST
# exceed EMAIL_TIMEOUT, or a slow provider lets a second worker start the same
# send while the first is still inside it. It is also how long a crashed
# worker's row waits for the next pass, so keep it near - not far above - the
# drain interval.
NOTIFICATION_OUTBOX_LEASE_SECONDS=60

# Attempts per row before it is dead-lettered. This is the bound that makes a
# permanently-failing notification stop consuming the batch. Small on purpose:
# an attempt costs a provider round trip and a refusal usually will not fix
# itself. A dead-lettered row is re-opened by an operator with
# `manage.py drain_notification_outbox --retry-dead`.
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5

# Retry backoff: NOTIFICATION_OUTBOX_RETRY_BASE_SECONDS * 2**(attempt-1), capped
# at NOTIFICATION_OUTBOX_RETRY_MAX_SECONDS. The invariant is that a row whose
# next attempt is in the future is not claimed, so the ratio between these two
# is the policy and either can change with the deployment. Keep the cap well
# inside NOTIFICATION_OUTBOX_TTL_SECONDS, or a row that keeps failing ages out
# and is purged instead of being dead-lettered.
NOTIFICATION_OUTBOX_RETRY_BASE_SECONDS=30
NOTIFICATION_OUTBOX_RETRY_MAX_SECONDS=3600

# --- Celery: broker, result backend, and the beat schedule --------------------
#
# The worker and the scheduler. Two processes:
#
#   celery -A config worker -l info     # executes queued tasks
#   celery -A config beat   -l info     # fires the schedule below
#
# Beat is what actually makes the sweeps above run: without it nothing expires
# a stale reservation and nothing drains the notification outbox. Running a
# worker without beat is a valid combination (queued work is executed, nothing
# new is scheduled); running beat without a worker lets the schedule pile up
# tasks nobody executes, which is why both are documented together.
#
# REDIS_URL is the ONE knob for both the broker and the result backend, so
# pointing the deployment at a managed Redis is a single value. Declaring it
# ALSO moves the DRF throttle cache onto that Redis (TIER1-THROTTLE-CACHE), so
# a scope's rate limit holds once for the whole deployment instead of once per
# worker process. Leave it UNSET for local development: Celery then falls back
# to the same localhost default that settings.py carries for the broker, and
# the throttle cache stays the per-process LocMemCache, so no Redis is needed
# to run the app or the test suite. When set, point it at a LOCAL Redis with no
# password - a development convenience, not a credential; set your own URL
# here and the password lives in your secret store, never in this file.
# Override CELERY_BROKER_URL / CELERY_RESULT_BACKEND individually only if you
# want the queue and the result store on different instances (a longer-lived
# results instance is the usual reason). Any non-Redis broker works if you set
# its URL and install that broker's client; Redis is the default, not a
# constraint.
#REDIS_URL=redis://localhost:6379/0
# Test-run isolation (P0-1), read only by a `manage.py test` invocation. When
# REDIS_URL is set, the test run's default cache is rewritten to this DB index
# so cache.clear() (FLUSHDB, which ignores KEY_PREFIX) cannot wipe the
# deployment's keys. The runner also takes an exclusive OS file lock keyed on
# the resolved test database: TEST_SUITE_LOCK_TIMEOUT is how many seconds a
# second suite waits before refusing to start, and TEST_SUITE_LOCK_DIR
# overrides the lock location (empty = the OS temp directory).
#TEST_REDIS_DB=13
#TEST_SUITE_LOCK_TIMEOUT=5
#TEST_SUITE_LOCK_DIR=
#CELERY_BROKER_URL=redis://queue.internal:6379/0
#CELERY_RESULT_BACKEND=redis://results.internal:6379/1

# Queue name, so a deployment sharing one Redis with another application cannot
# have this store's tasks consumed by that application's worker (or the
# reverse). Only change it if you deliberately run several queue names.
CELERY_TASK_DEFAULT_QUEUE=perfume_store

# Run tasks INLINE in the calling process instead of publishing them. Off by
# default and not a test setting: it is for a single-host deployment that runs
# beat inside the web process and has no separate worker. Leave it off
# anywhere a worker exists - with it on, a beat tick executes the sweep in the
# web process, which serialises your slowest sweep into your request path.
CELERY_TASK_ALWAYS_EAGER=false

# --- Beat cadences ------------------------------------------------------------
#
# Each sweep's interval, and the constraint that puts the default where it is.
# All three run the EXISTING management commands (common/tasks.py calls them
# through call_command), so a manual run and a scheduled run are the same code.
#
# The stale-reservation sweep must run well inside RESERVATION_TTL above, or a
# hold can sit past its own expiry - unreleasable, and still gating
# available-to-sell. Five minutes is a third of the default TTL, so a late tick
# or a restarting worker still leaves room for more passes before a hold goes
# stale. A non-integer value, or one below 1, is ignored with a warning.
CELERY_BEAT_EXPIRE_EVERY_MINUTES=5
# The outbox drain runs EVERY MINUTE by default. Honest arithmetic, because
# the tempting claim here is wrong: a retried row waits its backoff PLUS up to
# one tick, so with CELERY_BEAT_RETRY_BASE_SECONDS=30 above and a 60s tick, a
# first retry really waits 30-90s. A one-minute tick does NOT sit inside the
# 30s base backoff, and no default here claims it does - that is the same
# trade the `* * * * *` cron line this replaces already made. Lower it if your
# provider is fast and you want a tighter queue SLA; crontab cannot express
# anything under a minute, which is why this one is in seconds.
CELERY_BEAT_DRAIN_OUTBOX_SECONDS=60
# The outbox purge is a daily retention sweep at 03:17 - off the hour on
# purpose, so deployments that copied this schedule do not all wake up at
# 00:00. It enforces a bound measured in DAYS (NOTIFICATION_OUTBOX_TTL_SECONDS
# above), so a sub-daily cadence would delete nothing extra. Only the hour is
# configurable; the minute is not a knob any deployment needs.
CELERY_BEAT_PURGE_HOUR=3

# Note on the DRF throttle cache: it is still per-process LocMemCache and is
# NOT switched to Redis by CELERY above. It was deliberately left alone -
# Redis is not present in the test environment, so moving the default cache
# would break CI. The per-process throttle cache remains an open finding,
# tracked separately from this scheduler work.

# Throttle rates for public endpoints ("requests/period",
# period: s/sec/m/min/h/hour/d/day). coupon = apply-coupon preview,
# cart = cart add/update/remove, auth = login + verify-email +
# password-reset confirm + token refresh,
# recovery = email-sending flows (resend verification, forgot username,
# password reset) - tighter because each request sends an email.
# payment = payment intent minting (create_payment) - each accepted
# request calls the gateway and writes a payment event.
# restock = SPEC-19-4 back-in-stock opt-in/opt-out - each opt-in is intent
# to receive an outbound email, so it gets the recovery-shaped budget.
# webhook = SPEC-1-06 payment webhook deliveries - server-to-server, arrive
# in bursts, so the budget bounds parsing work and honest traffic, not
# credential guessing (the signature is what defends that endpoint).
# Q-S3: register and username-available left the shared auth budget for
# their own scopes - the two username-enumeration surfaces get budgets
# tighter than auth by default, tunable independently.
THROTTLE_COUPON_RATE=10/min
THROTTLE_CART_RATE=60/min
THROTTLE_AUTH_RATE=10/min
THROTTLE_REGISTER_RATE=5/min
THROTTLE_USERNAME_PROBE_RATE=5/min
THROTTLE_RECOVERY_RATE=5/min
PAYMENT_THROTTLE_RATE=10/min
THROTTLE_RESTOCK_RATE=5/min
# SPEC-Q-RS1: per-(IP + email) pair budget for GUEST restock opt-ins;
# separate from THROTTLE_RESTOCK_RATE so the pair bound can be tightened
# without moving the per-IP/user budget the authed path draws on.
THROTTLE_RESTOCK_GUEST_RATE=5/min
THROTTLE_WEBHOOK_RATE=120/min
# D-08: the anonymous customer tracking read. The guest token is the
# credential; this budget bounds order-number enumeration per client ident.
THROTTLE_TRACKING_RATE=60/min
# Q-S4: the Django admin login form is a plain Django view that the DRF
# scoped budgets above never cover; this is its own FAILED-attempt budget
# per client ident (a successful login spends nothing). 'n/min' as above;
# an empty value disables the bound (kill switch). Defaults to 10/min.
THROTTLE_ADMIN_LOGIN_RATE=10/min

# Q-S3 access gate (F3): the application-level signed-challenge hook on
# POST /api/accounts/register/ and GET /api/accounts/username-available/.
# EMPTY (the default) disables the hook - zero-config deployments and the
# test suite behave exactly as before. Set it to the shared secret that the
# owner-side edge gate (e.g. a Cloudflare Turnstile Worker, whose own keys
# stay in the Cloudflare dashboard) uses to mint the `challenge` parameter
# the endpoints then require: a Django TimestampSigner token with
# salt="accounts.access-challenge" over the payload "accounts-access":
#   TimestampSigner(key=secret, salt="accounts.access-challenge")
#       .sign("accounts-access")
# (stamped with a b62 time at mint; a non-Python minter reproduces it from
# the signer's recipe: base64 HMAC-SHA-256 keyed with the salt label mixed
# into the secret.)
# Missing, foreign-key, tampered and stale tokens are all refused with the
# SAME 403 body. Max age is the token's freshness window in seconds; a value
# below 1 disables only the age check - the signature stays required.
ACCOUNT_CHALLENGE_SECRET=
ACCOUNT_CHALLENGE_MAX_AGE=300

# Number of reverse proxies between the internet and this app. The throttle
# rates above budget anonymous callers per IP address, and behind a proxy
# every caller arrives with the same REMOTE_ADDR - the proxy's - so this count
# decides whether those budgets are per deployment or per caller. It is read
# as a DRF API setting and applies to every scope above at once.
#   0 (the default)
#     trusts no forwarded header: every caller behind the proxy shares one
#     budget per scope. Safe, and the fail-closed direction.
#   N (the real hop count)
#     budgets follow the real client address, so one abusive caller cannot
#     lock everyone else out and honest callers get their own budget. Set it
#     ONLY behind a proxy that appends the address it saw to
#     X-Forwarded-For and overwrites any client-supplied copy - otherwise a
#     caller forges the header and mints a fresh budget per request.
# A non-integer value, or one below 0, is ignored and the default is used.
NUM_PROXIES=0

# Ops dashboard / staff health endpoint: products with stock at or below this
# many units are flagged as "low stock" (admin dashboard table + the counters
# on GET /api/v1/admin/health/, gated by reports.read). Since the Q-S2/F2
# health split the public /health/ body no longer carries stock counters.
# Non-integer values are ignored and the default is used instead.
LOW_STOCK_THRESHOLD=5

# Ops dashboard "Sales over time" chart: trailing window in calendar days
# ending today. Non-integer values are ignored and the default is used instead.
DASHBOARD_SALES_WINDOW_DAYS=30

# SPEC-19-2 Admin alerts (low stock, out of stock, payment-failure spikes,
# security-sensitive account changes, integration outages). ALERT_RECIPIENTS
# is a comma-separated list of staff mailboxes; leave it EMPTY to disable
# admin alerts entirely (nothing is sent, triggers stay no-ops).
ALERT_RECIPIENTS=
# Per-alert-type dedupe: an alert type that already sent within this many
# seconds is logged instead of re-sent (protects the inbox from the
# pollable /health/ and dashboard triggers). Non-integer values are ignored
# and the default is used instead.
ALERT_COOLDOWN_SECONDS=300
# The alert cooldown lives on a dedicated cache alias so the dedupe window
# is shared across gunicorn workers (ASYNC-2d). Default backend is
# FileBasedCache (zero-dependency shared backend); point ALERT_CACHE_BACKEND
# at Redis/Memcached once SPEC-2-03 wires one. ALERT_CACHE_LOCATION is the
# FileBasedCache directory (default: backend/alert_cache) — leave it empty
# to take that default, because an empty FileBasedCache LOCATION resolves to
# the process working directory.
ALERT_CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
ALERT_CACHE_LOCATION=
# Payment-failure spike rule: at least PAYMENT_FAILURE_SPIKE_COUNT failed
# payment attempts within the trailing PAYMENT_FAILURE_SPIKE_WINDOW_SECONDS
# seconds fires one spike alert (then the cooldown applies).
PAYMENT_FAILURE_SPIKE_COUNT=3
PAYMENT_FAILURE_SPIKE_WINDOW_SECONDS=300

# Storefront products listing: rows per page. The historical hardcoded 2 was
# a dev/test artifact (F-23); 12 is a storefront-appropriate default.
# Non-integer values are ignored and the default is used instead.
PRODUCTS_PAGE_SIZE=12

# [R-21.2.6] Duplicate checkout submissions (double-click / client retry)
# within this many seconds collapse onto the still-payable pending order
# with the identical payload, instead of creating a second order. The guard
# only closes the accidental window; header-keyed idempotency is SPEC-9-01.
# Non-integer values are ignored and the default is used instead.
CHECKOUT_DEDUP_WINDOW_SECONDS=300

# Error tracking (SPEC-22-04 [R-22.13]) — OPTIONAL and inert without a DSN.
# SENTRY_DSN is the tracker project's ingest DSN. Leave it UNSET and the app
# never imports the SDK, never initialises anything and never makes an
# outbound call: local development, CI and the test suite are unaffected. Set
# it in production and unhandled exceptions plus the django.request 5xx
# records the app already logs (SPEC-7-02 pins that channel at ERROR) are
# reported to the project named by the DSN.
# The DSN carries a public ingest key, so it is still configuration, not a
# secret to commit: it lives in this .env / the repo-root .env / your
# platform's secret store, never in the repository.
# SENTRY_ENVIRONMENT labels the events. Defaults to DJANGO_ENV (local | ci |
# staging | production), so a staging error is never filed as a production
# one; set it only to override that (e.g. a canary release sharing the
# production DSN).
# SENTRY_SAMPLE_RATE is the fraction of error events kept, 0.0-1.0 (default
# 1.0 — every event). Lower it on a noisy deployment; it is a float and a
# non-numeric or out-of-range value falls back to the default with a warning.
# SENTRY_TRACES_SAMPLE_RATE is the performance/tracing fraction (default 0.0,
# off): this app instruments no transactions, so a non-zero value would bill
# for telemetry nothing consumes. The SDK is pinned in requirements.txt and
# is imported ONLY when a DSN is set.
#
# FREE-TIER CEILING. Sentry is billed in events, and one noisy exception in a
# hot loop can spend a month's quota in minutes. Every event therefore passes a
# before_send guard that drops the known-noise denylist (404/403/DisallowedHost,
# health-check paths, BrokenPipeError, transient DB OperationalError), drops an
# identical (exception type, message) pair seen in the last 60 seconds, and then
# enforces BOTH caps below. When a cap is hit the event is dropped and one local
# warning is logged per window; nothing is re-sent and the guard never raises.
# The counter is SHARED across workers when REDIS_URL is declared (the same
# declaration that moves the throttle cache and Celery onto Redis). Leave
# REDIS_URL unset and each process gets its own counter, which is the honest
# one-worker/local/CI behaviour. Both caps take positive integers; zero or a
# malformed value falls back to the documented default rather than disabling
# the ceiling.
# SENTRY_MAX_EVENTS_PER_MINUTE=10
# SENTRY_MAX_EVENTS_PER_HOUR=200
#
# RELEASE_SHA (or GIT_SHA) labels every event with the deployed commit, so an
# error is tied to the build that produced it. Either name is accepted because
# CI systems export different ones; both are optional and neither is guessed.
# RELEASE_SHA=
# GIT_SHA=
# SENTRY_DSN=https://<public-key>@<ingest-host>/<project-id>
# SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=0.0

# SPEC-9-04 Customer order-history listing (GET /api/orders/): rows per
# page, and the ceiling a ?page_size caller may request. Non-integer values
# are ignored and the defaults are used instead.
ORDER_HISTORY_PAGE_SIZE=10
ORDER_HISTORY_MAX_PAGE_SIZE=100

# SPEC-1-B07b [R-1.16] Customer returns listing (GET /api/orders/returns/): rows
# per page, and the ceiling a ?page_size caller may request. A SEPARATE pair
# rather than reusing ORDER_HISTORY_*: the store may want a denser returns page
# than order page, and one knob for both would force that choice. Non-integer
# values are ignored and the defaults are used instead.
#
# There is deliberately NO return-window key here, and that is a build-order
# state rather than a settled policy. Spec 4 line 1083 ("Return/refund request
# where eligible") and spec 6.8 line 1959 ("Eligibility validation") both
# describe a window the specification never gives a number for - a whole-file
# sweep for a day count finds one hit and it is about deployment cadence, not
# returns - so this task invented none. THE PRODUCT OWNER HAS SINCE REQUIRED a
# configurable site-wide return window: SPEC-1-B07d owns it, and it will NOT
# arrive as a key here. A return window is merchant-facing policy that each
# store sets for itself, so it will be an ops.SiteSettings row rather than an
# env value; the two keys below stay env-driven because a page density is
# deployment-shaped, not store-shaped. Until B07d lands, an order's AGE IS NOT
# AN INPUT to eligibility.
RETURNS_HISTORY_PAGE_SIZE=10
RETURNS_HISTORY_MAX_PAGE_SIZE=100

# SPEC-12-01 Inventory reservation: how many seconds a checkout's stock
# reservation holds units before it goes stale and the reconciliation
# command (expire_reservations) releases them back to the sellable pool.
# Coordinate with the payment window (Razorpay checkout session) so a
# customer can always finish paying inside the hold. Non-integer values
# are ignored and the default is used instead.
RESERVATION_TTL=900

# SPEC-1-B05 [R-1.07] Free-shipping rule (spec 6.9). When set, an order whose
# MERCHANDISE total (cart subtotal after discount, before shipping) reaches
# this amount is charged nothing for delivery; below it, the rate that matches
# the destination is charged. Leave it EMPTY (the default) to switch the rule
# off and always charge the configured rate.
#
# DANGER: 0 is NOT the same as empty. SHIPPING_FREE_THRESHOLD=0 turns the
# rule ON at zero, so EVERY shipment is free, for every order, forever - the
# store collects no delivery revenue at all and nothing errors. To switch the
# rule off you must leave the value EMPTY, not set it to 0.
#
# A money amount in the store currency, read as a Decimal. Anything that is
# not a usable non-negative money amount is ignored with a warning and the
# rule is left OFF (i.e. always charged), so a typo here can never take the
# app down or make every shipment free. That covers unparseable text, a
# negative amount, the non-finite values NaN/Infinity, and a value above
# 99999999.99 (the largest amount this store's money columns can hold).
# Shipping RATES themselves are not env config: they are staff-managed rows
# (ShippingMethod/ShippingRate, admin -> Shipping), because they change per
# geography far more often than a deployment changes its env. A store with no
# active method is reported as shipping_configured=false on /health/, warned
# about on every checkout, and can be seeded with
# `python manage.py seed_shipping_methods`.
SHIPPING_FREE_THRESHOLD=

# SPEC-12-03 Reconciliation cadence: schedule `python manage.py
# expire_reservations` well inside RESERVATION_TTL (e.g. every minute via
# cron or celery-beat; the scheduler wiring itself belongs to the
# background-jobs/deployment work, S19/S22). Coordination rules with the
# payment provider: the TTL must exceed the Razorpay checkout-session
# window (a customer must be able to finish paying inside the hold), and
# the sweep cadence must be shorter than the TTL so stale holds clear
# promptly. The sweep reclaims the reservation book only — payment truth
# (webhook/timeout reconciliation, SPEC-1-06/SPEC-1-18) is never touched,
# and a late verify of a swept checkout still lands on verify_payment's
# re-checked stock (SPEC-12-02).

# [R-8.11] Store currency for every money column (orders, order items).
# New orders/items record this ISO 4217 code beside their amounts and the
# payment gateway is charged in it. Must be exactly three letters
# (case-insensitive); an invalid value falls back to INR with a warning.
# Changing it affects NEW orders only — existing rows keep the currency
# they were minted with (the 0008 migration backfilled all pre-existing
# rows to INR, so historical data stays deterministic).
DEFAULT_CURRENCY=INR

# SPEC-16-T4 Internationalization, read once at startup.
# LANGUAGE_CODE must be a Django-known language tag: a 2- or 3-letter ISO 639
# primary subtag, optionally followed by region/script subtags (en-us, de,
# pt-br, zh-hans). Anything else falls back to en-us with a warning.
# TIME_ZONE must be an IANA zone name (UTC, Asia/Kolkata, America/New_York);
# an unknown or path-shaped value falls back to UTC with a warning. Neither
# typo can take the boot down.
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# SPEC-17-01 JWT lifetimes, in integer seconds. The access token is a
# short-lived bearer credential (default 900 = 15 minutes); the refresh
# token outlives it (default 604800 = 7 days) and ROTATES on every use
# with blacklist-after-rotation, so a leaked refresh token cannot be
# replayed and password reset/logout revoke outstanding sessions.
# Coordinate the pair: the refresh window bounds how long a customer can
# stay signed in without re-authenticating; the access window bounds how
# long a stolen bearer credential is usable. Non-integer values fall back
# to the documented defaults.
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=604800

# SPEC-17-02 refresh-token cookie. The refresh token never enters the JSON
# response body (or browser localStorage); it rides an HttpOnly cookie set
# on login and re-set on every rotation. NAME/PATH/SAMESITE are env-driven;
# Secure is added automatically whenever DEBUG is false. Keep PATH covering
# the API surface (accounts routes mount at /api/accounts/ and
# /api/v1/account/). SAMESITE=Lax blocks cross-site attachment on POSTs
# (refresh/logout are POST-only) while matching the same-site frontend/API
# deployment constraint; tighten to Strict only after verifying no
# navigation flow depends on the cookie.
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_PATH=/api/
JWT_REFRESH_COOKIE_SAMESITE=Lax

# SPEC-Q-P1 dual-accept window for the legacy body-borne refresh token.
# The refresh endpoint NEVER issues a token in the JSON body; while this
# window is open it still ACCEPTS one presented there, so a client that
# predates the HttpOnly-cookie cutover (Q-F3's frontend half) is not
# bricked mid-migration. ENABLED is the kill switch (set false to retire
# the body carrier outright); otherwise the window closes START + DAYS
# after the anchor, so the default is generous on purpose - flip the flag
# when the frontend has shipped everywhere, or shorten DAYS to schedule
# the close. START takes an ISO date (YYYY-MM-DD); a malformed value falls
# back to the default anchor rather than failing boot.
JWT_REFRESH_BODY_ACCEPT_ENABLED=true
JWT_REFRESH_BODY_ACCEPT_START=2026-10-15
JWT_REFRESH_BODY_ACCEPT_DAYS=90

# SPEC-17-03 CSRF for session-cookie cart/checkout mutations. The session
# cookie carries the cart identity, so its SameSite policy is explicit
# here: Lax matches the refresh cookie's reading (cross-site POSTs cannot
# attach it). This is the same-site belt — the actual gate is server-side
# (SessionCartCSRFAuthentication): unsafe requests that ride the session
# cookie must replay the csrftoken cookie (issued by GET /api/cart/) as
# X-CSRFToken, which the SPA does automatically. JWT-bearer requests are
# never gated. CSRF_TRUSTED_ORIGINS above must list the deployed storefront
# origin for HTTPS Referer/Origin checking.
SESSION_COOKIE_SAMESITE=Lax

# SPEC-17-07 Transport/cookie hardening, ENABLED in the deployment path by
# SPEC-22-08 [R-22.6]: docker-compose.yml sets these with production
# defaults, so a compose deployment gets HTTPS-only redirects and a one-year
# HSTS window without anyone editing a file. The defaults written HERE are the
# development-safe ones (settings.py keeps them, and DJANGO_DEBUG=true never
# gets the hardening on), because this file is what a developer copies for a
# plain-HTTP local run. Every key below is a pass-through in compose, so the
# repo-root .env overrides any of it: a plain-HTTP local `docker compose up`
# must set SECURE_SSL_REDIRECT=false and SECURE_HSTS_SECONDS=0. All flags are
# env-gated; enable them together with real TLS:
#   SECURE_HSTS_SECONDS       0 disables the HSTS header entirely (safe
#                             default; a non-zero value like 31536000 tells
#                             browsers to refuse plain HTTP for that long
#                             - only once the host is fully HTTPS).
#   SECURE_HSTS_INCLUDE_SUBDOMAINS / SECURE_HSTS_PRELOAD
#                             only with HSTS enabled, and only once EVERY
#                             subdomain is HTTPS-safe (preload is
#                             effectively irreversible).
#   SECURE_SSL_REDIRECT       redirect plain-HTTP requests to HTTPS; off
#                             locally so dev and tests keep working.
#   SECURE_PROXY_SSL_HEADER_NAME/_VALUE
#                             the forwarded-scheme header the TLS-terminating
#                             proxy sends, as the WSGI environ NAME Django
#                             actually looks up (request.META[header]): the
#                             wire header X-Forwarded-Proto arrives as
#                             HTTP_X_FORWARDED_PROTO, so the name is that,
#                             not "X-Forwarded-Proto" (a bare header name
#                             never matches and every proxied request looks
#                             like plain HTTP, which loops the SSL redirect).
#                             BOTH parts must be set to take effect, and only
#                             from a proxy that sets the header on every
#                             request and overwrites any client-supplied copy
#                             (a forgeable pair lets a client lie about its
#                             scheme). Leave unset otherwise.
#   USE_X_FORWARDED_HOST      resolve the request host from X-Forwarded-Host
#                             (the host the proxy actually served) instead of
#                             the Host header the client sent, which a proxy
#                             usually rewrites on the way through. Off by
#                             default: a forwarded host is only as
#                             trustworthy as the proxy that sets it, and
#                             without one a caller dictates the host Django
#                             validates against ALLOWED_HOSTS. Set it only
#                             alongside a proxy that overwrites the header.
#                             (It resolves the host; NUM_PROXIES above is
#                             what keys an anonymous throttle budget on the
#                             caller's address.)
# SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE default to "Secure whenever
# DEBUG is false", matching the JWT refresh cookie's secure=not-DEBUG
# contract, so the three auth cookies never disagree about transport
# security; set them explicitly only to force an override.
# What docker-compose.yml actually sets for a compose deployment:
#   SECURE_SSL_REDIRECT=true  SECURE_HSTS_SECONDS=31536000
#   SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
#   SECURE_PROXY_SSL_HEADER_VALUE=https
SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
# SECURE_SSL_REDIRECT=false
# SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# SECURE_PROXY_SSL_HEADER_VALUE=https

# SPEC-17-08 [R-17.21] Product image upload ceiling, in whole MB. Enforced
# on every upload surface (the staff API product create/update and the
# admin product form) with a 400 validation error; oversize uploads are
# rejected before any bytes are written to storage. If you raise this,
# also raise the web server's own request-body limit (it fires first and
# answers with its own 413). Non-integer values fall back to the default.
MAX_UPLOAD_MB=5

# Frontend base URL used in verification/reset links and order-confirmation emails
FRONTEND_URL=http://localhost:3000
# SPEC-20-13: the enrollment page the admin login page links to when
# mandatory MFA (R-17.9) blocks an unenrolled privileged account. Defaults
# to $FRONTEND_URL/staff/mfa/enroll; set it only when the storefront and
# the API/admin are served from different origins.
#MFA_ENROLL_URL=http://localhost:3000/staff/mfa/enroll

# SPEC-20-8 "trust this device for N days" on the privileged MFA door
# (opt-in, per browser; a privileged staff member asks for it once and is not
# challenged on that device until it lapses). Days the grant lasts after the
# user explicitly asks for it. Set to 0 to put every privileged login back
# behind a fresh code — the emergency kill switch. Defaults to 30.
#MFA_TRUST_DAYS=30
# Name of the HttpOnly signed marker that binds a trusted device to the
# browser that asked for it; override only to keep it apart from another
# cookie on the same host.
#MFA_TRUST_COOKIE_NAME=mfa_trusted_device
# Sent on same-site requests only; 'Strict' is the safe default and is what
# keeps the marker off cross-site navigations.
#MFA_TRUST_COOKIE_SAMESITE=Strict

# SPEC-E2E-01: `manage.py seed_e2e` creates the owner's local end-to-end test
# data (superadmin, storefront customer, catalogue, orders, parcels). It
# REFUSES to run unless --i-know-this-is-a-test-db is passed AND the resolved
# database looks like a test DB (DEBUG=true, the sqlite engine, or a
# DATABASE_URL host of localhost/127.0.0.1), because every row it writes is
# test data and the credentials below are test credentials.
#
# The command carries no credential literals. Supply these values, or leave
# them unset and the command generates each one and prints it once with a
# "SAVE THIS NOW" warning. A re-run keeps an existing account's password and
# an existing device's secret unless the matching value here is set explicitly
# (an explicit value rotates it).
#SEED_E2E_SUPERADMIN_PASSWORD=
#SEED_E2E_CUSTOMER_PASSWORD=
#SEED_E2E_TOTP_SECRET=
