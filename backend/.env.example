# Environment template — copy to .env and fill in. NEVER commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DEBUG fails CLOSED: absent means false, so an unconfigured deployment boots
# hardened. Set true only for local development.
DJANGO_DEBUG=false
# The environment this deployment IS: local, ci, staging or production.
# Required when DEBUG=false; an unknown value is refused at boot rather than
# guessed. Isolation is per environment: one database and one secret each.
DJANGO_ENV=production
# Non-debug boots must state hosts and origins explicitly.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# App log level (DEBUG/INFO/WARNING/ERROR/CRITICAL); unknown values warn and
# fall back to INFO. 5xx stay at ERROR and the audit trail is pinned at INFO.
# LOG_FILE (optional) adds a rotating file handler (5 MB x 3); leave it unset
# for console-only output, which is safe on read-only filesystems.
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# PostgreSQL in production, sqlite for local dev. Schemes: postgres:// /
# postgresql://, or sqlite:///relative/path (sqlite:////abs/path for absolute).
# Missing/malformed/unsupported URLs fall back to backend/db.sqlite3 only when
# DJANGO_DEBUG=true; with DEBUG=false the boot is refused instead of silently
# serving developer data. An explicit sqlite:// URL is honoured anywhere.
# Query params become Postgres OPTIONS, so a remote managed database MUST carry
# its TLS setting here (?sslmode=require, verify-ca or verify-full).
# DATABASE_URL=postgres://user:password@localhost:5432/perfume_store
# DATABASE_URL=postgres://user:password@db.example.com:5432/perfume_store?sslmode=require
# DATABASE_URL=sqlite:///db.sqlite3

# `manage.py backup_db` dumps the database, then keeps the newest
# BACKUP_RETENTION dumps (default 7; non-numeric falls back, below 1 refused).
# BACKUP_DIR is REQUIRED and is a HOST path: a dump in a container's writable
# layer is lost on replacement, and scripts/backup.sh bind-mounts it into the
# one-shot container (a bare `docker compose run ... backup_db` would create it
# inside the throwaway container). Schedule/restore: docs/deploy-runbook.md.
# BACKUP_RETENTION=7

# Where collectstatic gathers assets; whitenoise serves them from the app
# process, so DEBUG=false needs no separate web server. Unset means
# backend/staticfiles (what the image uses).
# DJANGO_STATIC_ROOT=/app/staticfiles

# UPLOADS (media, not static) must survive a container restart: unset locally
# (backend/media), point it at the persistent volume in production
# (compose mounts media_data at /app/media). Anything else loses uploads when
# the container is replaced.
# DJANGO_MEDIA_ROOT=/app/media
# Storage backend (settings.STORAGES) is switchable without a code change; a
# value that is not a dotted path is refused at boot, not on first upload.
# DJANGO_MEDIA_BACKEND=django.core.files.storage.FileSystemStorage
#
# S3-compatible uploads (TIER1-S3-MEDIA): django-storages' S3Storage covers
# both Cloudflare R2 and AWS S3; R2 differs by ONE value, AWS_S3_ENDPOINT_URL.
# All of it is per-deployment config in your env/secret store, NEVER in this
# repo (white-label: no bucket, credential or endpoint in source).
#   AWS_STORAGE_BUCKET_NAME  REQUIRED with the S3 backend; boot is refused
#     without it rather than failing on the first upload.
#   AWS_S3_ENDPOINT_URL  set for R2 or any S3-compatible service; leave UNSET
#     for AWS S3 itself.
#   AWS_S3_REGION_NAME  the bucket's region; unset applies the provider default.
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  leave both unset to use boto3's
#     own chain (shared config, instance/task roles).
#   AWS_S3_CUSTOM_DOMAIN  optional CDN/custom domain for storage.url().
# Name collisions are suffixed, never a silent overwrite.
# DJANGO_MEDIA_BACKEND=storages.backends.s3.S3Storage
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=
# The front door should serve /media/ from the same volume; Django also serves
# it (config/urls.py), so a missing rule degrades to a served file, not a 404.

# CORS / CSRF (comma-separated). Both loopback spellings are listed because the
# storefront is reachable at either. Outside development both must be set
# explicitly; the values below are for local work only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay (rotate any key that has ever been committed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The value Razorpay signs each delivery with (Dashboard -> Settings ->
# Webhooks), separate from the key pair - rotating one does not rotate the
# other. Empty means every delivery gets 503; unsigned is never accepted.
RAZORPAY_WEBHOOK_SECRET=
# Seconds the refund seam waits on Razorpay. It runs inside the caller's
# transaction holding the order's row lock, so a stalled gateway blocks every
# refund for that order; a trip rolls the attempt back whole. Non-integer or
# below 1 is ignored and 10 is used.
RAZORPAY_TIMEOUT=10

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds to wait on the mail server for the whole SMTP conversation. Unset
# means NO timeout, and sends run inline inside the caller's transaction, so a
# stalled relay is a checkout-blocking outage. Non-integer or below 1 is
# ignored (0 would make the socket non-blocking) and 10 is used.
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=

# How long a queued notification row may sit before the purge command deletes
# it. The payload is NOT credential-scrubbed (a reset mail needs its one-time
# token), so deletion on a clock is the control. Default 3 days.
NOTIFICATION_OUTBOX_TTL_SECONDS=259200

# --- Notification outbox drain ------------------------------------------------
#
# Celery beat drains the outbox (see CELERY_BEAT_DRAIN_OUTBOX_SECONDS below);
# start the worker and beat and the drain, purge and reservation sweeps run on
# their own. On a host with no worker, the equivalent cron form still works:
#
#   * * * * *  manage.py drain_notification_outbox --verbosity 0
#   17 3 * * *  manage.py purge_notification_outbox --verbosity 0
#
# Pick ONE: running both is safe (rows are claimed under a lock) but pointless.
# A failed row waits its backoff PLUS up to one interval, which is why the beat
# drain runs every minute rather than every five.

# Rows one drain pass may claim; bounds a backlog, not a runtime.
NOTIFICATION_OUTBOX_DRAIN_BATCH_SIZE=100

# How long a claimed row is out of other workers' reach. MUST exceed
# EMAIL_TIMEOUT, or a slow provider lets a second worker start the same send;
# keep it near the drain interval so a crashed worker's row is retried soon.
NOTIFICATION_OUTBOX_LEASE_SECONDS=60

# Attempts per row before dead-lettering, so a permanently failing send stops
# consuming the batch. Re-open with `manage.py drain_notification_outbox
# --retry-dead`.
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5

# Backoff: BASE * 2**(attempt-1), capped at MAX. A row whose next attempt is in
# the future is not claimed. Keep the cap well inside OUTBOX_TTL, or a failing
# row is purged before it can be dead-lettered.
NOTIFICATION_OUTBOX_RETRY_BASE_SECONDS=30
NOTIFICATION_OUTBOX_RETRY_MAX_SECONDS=3600

# --- Celery: broker, result backend, and the beat schedule --------------------
#
# Two processes: `celery -A config worker -l info` executes queued tasks and
# `celery -A config beat -l info` fires the schedule. Without beat nothing
# expires a stale reservation or drains the outbox.
#
# REDIS_URL is the ONE knob for broker and result backend; declaring it ALSO
# moves the DRF throttle cache onto that Redis, so a rate limit holds once per
# deployment rather than once per worker. Leave it UNSET locally: Celery falls
# back to settings.py's localhost broker and the cache stays per-process
# LocMemCache, so no Redis is needed to run the app or the tests. Use a LOCAL
# Redis with no password here; a real password belongs in your secret store.
# Override CELERY_BROKER_URL / CELERY_RESULT_BACKEND individually only to split
# queue and results across instances. Redis is the default, not a constraint.
#REDIS_URL=redis://localhost:6379/0
# Test-run isolation, read only by `manage.py test`. With REDIS_URL set, the
# test cache is rewritten to TEST_REDIS_DB so cache.clear() (FLUSHDB, ignoring
# KEY_PREFIX) cannot wipe deployment keys. The runner also holds an exclusive
# OS lock on the resolved test database: TEST_SUITE_LOCK_TIMEOUT is the wait
# before refusing to start, TEST_SUITE_LOCK_DIR overrides its location.
#TEST_REDIS_DB=13
#TEST_SUITE_LOCK_TIMEOUT=5
#TEST_SUITE_LOCK_DIR=
#CELERY_BROKER_URL=redis://queue.internal:6379/0
#CELERY_RESULT_BACKEND=redis://results.internal:6379/1

# Keeps this store's tasks from being consumed by another app sharing the
# Redis (or the reverse); change only to run several queue names.
CELERY_TASK_DEFAULT_QUEUE=perfume_store

# Runs tasks INLINE instead of publishing: only for a single-host deployment
# with no worker. Not a test setting - with a worker present it serialises the
# slowest sweep into the request path.
CELERY_TASK_ALWAYS_EAGER=false

# --- Beat cadences ------------------------------------------------------------
#
# All sweeps run the EXISTING management commands (common/tasks.py calls them
# through call_command), so a manual run and a scheduled run are the same code.
#
# The reservation sweep must run well inside RESERVATION_TTL, or a hold sits
# past its expiry unreleasable and still gates availability. Five minutes is a
# third of the default TTL. Non-integer or below 1 is ignored.
CELERY_BEAT_EXPIRE_EVERY_MINUTES=5
# Every minute by default. A retried row waits its backoff PLUS up to one tick,
# so with a 30s base the first retry really waits 30-90s. Seconds, because
# crontab cannot express anything under a minute.
CELERY_BEAT_DRAIN_OUTBOX_SECONDS=60
# Daily retention sweep at 03:17 - off the hour so copied schedules do not all
# wake at 00:00. The bound is measured in DAYS, so sub-daily would add nothing.
CELERY_BEAT_PURGE_HOUR=3

# Throttle rates ("requests/period"; period s/sec/m/min/h/hour/d/day).
# coupon = apply-coupon preview; cart = cart mutations; auth = login +
# verify-email + password-reset confirm + token refresh; recovery =
# email-sending flows (tighter: each request sends a mail); payment = intent
# minting (each calls the gateway); restock = back-in-stock opt-in (an outbound
# mail); webhook = payment deliveries (server-to-server bursts; the signature
# is the real defence); register / username-available are separate, tighter
# scopes for the two username-enumeration surfaces.
THROTTLE_COUPON_RATE=10/min
THROTTLE_CART_RATE=60/min
THROTTLE_AUTH_RATE=10/min
THROTTLE_REGISTER_RATE=5/min
THROTTLE_USERNAME_PROBE_RATE=5/min
THROTTLE_RECOVERY_RATE=5/min
PAYMENT_THROTTLE_RATE=10/min
THROTTLE_RESTOCK_RATE=5/min
# Per-(IP + email) budget for GUEST restock opt-ins, separate from the
# per-IP/user budget the authed path draws on.
THROTTLE_RESTOCK_GUEST_RATE=5/min
THROTTLE_WEBHOOK_RATE=120/min
# Anonymous tracking read; the guest token is the credential, so this bounds
# order-number enumeration per client.
THROTTLE_TRACKING_RATE=60/min
# The Django admin login is a plain view the DRF scopes never cover: its own
# FAILED-attempt budget per client (success spends nothing). Empty disables it.
THROTTLE_ADMIN_LOGIN_RATE=10/min

# Signed-challenge hook on register/ and username-available/. EMPTY disables
# it (zero-config and the test suite behave as before). Set it to the shared
# secret an owner-side edge gate uses to mint a `challenge`:
# TimestampSigner(key=secret, salt="accounts.access-challenge").sign("accounts-access").
# Missing, foreign, tampered or stale tokens all get the same 403; MAX_AGE is
# the freshness window in seconds (below 1 still requires the signature).
ACCOUNT_CHALLENGE_SECRET=
ACCOUNT_CHALLENGE_MAX_AGE=300

# Reverse proxies in front of the app. Behind one, every caller shares the
# proxy's REMOTE_ADDR, so 0 (fail-closed default) gives one budget per scope
# for the whole deployment. Set N to the real hop count ONLY behind a proxy
# that appends to X-Forwarded-For and overwrites client-supplied copies;
# otherwise a caller forges the header and mints a fresh budget per request.
NUM_PROXIES=0

# Products at or below this stock are "low stock" (admin dashboard and
# /api/v1/admin/health/, gated by reports.read; the public /health/ omits them).
LOW_STOCK_THRESHOLD=5

# Trailing window in calendar days for the "Sales over time" chart.
DASHBOARD_SALES_WINDOW_DAYS=30

# Comma-separated staff mailboxes for admin alerts (stock, payment spikes,
# security changes, integration outages). EMPTY disables all of them.
ALERT_RECIPIENTS=
# Per-alert-type dedupe window in seconds: an alert that already sent is
# logged instead of re-sent (the /health/ and dashboard triggers are pollable).
ALERT_COOLDOWN_SECONDS=300
# Cooldown state lives on a dedicated cache alias so the window is shared
# across gunicorn workers. Default backend is FileBasedCache; LOCATION empty
# takes backend/alert_cache (an empty location would mean the CWD).
ALERT_CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
ALERT_CACHE_LOCATION=
# At least COUNT failed payments within WINDOW seconds fires one spike alert
# (then the cooldown applies).
PAYMENT_FAILURE_SPIKE_COUNT=3
PAYMENT_FAILURE_SPIKE_WINDOW_SECONDS=300

# Rows per page on the storefront products listing.
PRODUCTS_PAGE_SIZE=12

# Duplicate checkout submissions within this window collapse onto the
# still-payable pending order with the identical payload. Closes only the
# accidental double-click/retry window; header-keyed idempotency is separate.
CHECKOUT_DEDUP_WINDOW_SECONDS=300

# Error tracking: OPTIONAL and inert without a DSN. Unset means the SDK is
# never imported, so local dev, CI and tests are unaffected. The DSN's ingest
# key is public, but it is still config, never committed.
# SENTRY_ENVIRONMENT labels events (defaults to DJANGO_ENV, so staging is never
# filed as production); SENTRY_SAMPLE_RATE is the 0.0-1.0 error fraction.
# SENTRY_TRACES_SAMPLE_RATE defaults off: this app instruments no transactions.
#
# No local event cap on purpose: a client-side ceiling goes quiet exactly
# during a spike and hides what it dropped. Bound spend with a Sentry client-key
# rate limit and inbound filters instead; before_send only drops known noise
# (404/403, health paths, BrokenPipe, DB OperationalError). The old
# SENTRY_MAX_EVENTS_PER_* keys were removed.
#
# RELEASE_SHA (or GIT_SHA) labels every event with the deployed commit; both
# optional, neither guessed.
# RELEASE_SHA=
# GIT_SHA=
# SENTRY_DSN=https://<public-key>@<ingest-host>/<project-id>
# SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Order-history listing: rows per page, and the ceiling ?page_size may request.
ORDER_HISTORY_PAGE_SIZE=10
ORDER_HISTORY_MAX_PAGE_SIZE=100

# Returns listing: rows per page and the ?page_size ceiling. A SEPARATE pair
# from ORDER_HISTORY_* so returns can be denser than orders.
#
# Deliberately NO return-window key: a window is merchant-facing store policy,
# so it will be an ops.SiteSettings row owned by SPEC-1-B07d, not env. Until
# then an order's age is NOT an eligibility input.
RETURNS_HISTORY_PAGE_SIZE=10
RETURNS_HISTORY_MAX_PAGE_SIZE=100

# Seconds a checkout's stock reservation holds units before expire_reservations
# releases them. Must exceed the payment window so a customer can finish paying.
RESERVATION_TTL=900

# Free-shipping threshold on the MERCHANDISE total (after discount, before
# shipping). EMPTY disables the rule and always charges the configured rate.
#
# DANGER: 0 is NOT empty. Setting 0 turns the rule ON at zero, making every
# shipment free forever, with no error. Leave EMPTY to switch it off.
#
# Invalid money (text, negative, NaN/Infinity, above 99999999.99) warns and
# leaves the rule OFF, so a typo cannot take the app down. Shipping RATES are
# staff-managed rows (admin -> Shipping), not env; seed a store with
# `manage.py seed_shipping_methods`.
SHIPPING_FREE_THRESHOLD=

# Schedule expire_reservations well inside RESERVATION_TTL so stale holds
# clear promptly. It reclaims the reservation book only: payment truth is never
# touched, and a late verify still re-checks stock on verify_payment.

# Store currency for every money column (ISO 4217, three letters; invalid
# falls back to INR). Changing it affects NEW orders only; existing rows keep
# their minted currency.
DEFAULT_CURRENCY=INR

# Read once at startup. LANGUAGE_CODE is a Django language tag (en-us, pt-br,
# zh-hans) and TIME_ZONE an IANA name; each typo falls back (en-us / UTC) rather
# than failing the boot.
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# JWT lifetimes in seconds. The access token is short-lived (900 = 15 min) and
# the refresh token (604800 = 7 days) ROTATES on use with blacklist-after-
# rotation, so a leaked token cannot be replayed and reset/logout revoke
# sessions. Coordinate the pair: refresh bounds sign-in, access bounds theft.
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=604800

# The refresh token never enters the JSON body or localStorage; it rides an
# HttpOnly cookie, Secure whenever DEBUG is false. Keep PATH covering the API
# (accounts routes mount at /api/accounts/ and /api/v1/account/). SameSite=Lax
# blocks cross-site attachment on the POST-only refresh/logout.
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_PATH=/api/
JWT_REFRESH_COOKIE_SAMESITE=Lax

# Dual-accept window for the legacy body-borne refresh token (never issued,
# still accepted while the window is open). ENABLED is the kill switch;
# otherwise it closes START + DAYS (START is an ISO date; malformed falls back
# to the default anchor rather than failing boot).
JWT_REFRESH_BODY_ACCEPT_ENABLED=true
JWT_REFRESH_BODY_ACCEPT_START=2026-10-15
JWT_REFRESH_BODY_ACCEPT_DAYS=90

# The session cookie carries the cart identity, so its SameSite policy is
# explicit (Lax, as the refresh cookie). The real gate is server-side:
# session-cookie mutations must replay the csrftoken cookie as X-CSRFToken
# (the SPA does this); JWT-bearer requests are never gated.
SESSION_COOKIE_SAMESITE=Lax

# Transport/cookie hardening. docker-compose.yml sets production defaults
# (HTTPS redirect + one-year HSTS) and every key is a pass-through, so a
# plain-HTTP local `docker compose up` must set SECURE_SSL_REDIRECT=false and
# SECURE_HSTS_SECONDS=0. The defaults HERE are the development-safe ones.
#   SECURE_HSTS_SECONDS  0 disables HSTS; non-zero tells browsers to refuse
#                        plain HTTP - only once the host is fully HTTPS.
#   SECURE_HSTS_INCLUDE_SUBDOMAINS / SECURE_HSTS_PRELOAD  only once EVERY
#                        subdomain is HTTPS-safe (preload is irreversible).
#   SECURE_SSL_REDIRECT  off locally so dev and tests keep working.
#   SECURE_PROXY_SSL_HEADER_NAME/_VALUE  the WSGI environ NAME Django looks up
#                        (HTTP_X_FORWARDED_PROTO, not the bare header name - the
#                        latter never matches and loops the redirect). BOTH must
#                        be set, only from a proxy that overwrites any
#                        client-supplied copy. Leave unset otherwise.
#   USE_X_FORWARDED_HOST  resolve the host from X-Forwarded-Host. Off by
#                        default: only as trustworthy as the proxy that sets it.
#                        (NUM_PROXIES above is what keys a throttle budget.)
# SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE default to Secure whenever DEBUG
# is false, matching the refresh cookie, so the three auth cookies agree.
# compose sets: SECURE_SSL_REDIRECT=true, SECURE_HSTS_SECONDS=31536000,
# SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO, ..._VALUE=https.
SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
# SECURE_SSL_REDIRECT=false
# SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# SECURE_PROXY_SSL_HEADER_VALUE=https

# Upload ceiling in whole MB, enforced on every upload surface; oversize is
# rejected before bytes are written. Raise the web server's body limit too (it
# fires first with its own 413).
MAX_UPLOAD_MB=5

# Frontend base URL used in verification/reset links and order-confirmation emails
FRONTEND_URL=http://localhost:3000
# Enrollment page the admin login links to when mandatory MFA blocks an
# unenrolled account. Defaults to $FRONTEND_URL/staff/mfa/enroll.
#MFA_ENROLL_URL=http://localhost:3000/staff/mfa/enroll

# "Trust this device" grant length in days for the privileged MFA door
# (opt-in, per browser). 0 is the emergency kill switch: every login needs a
# fresh code. Defaults to 30.
#MFA_TRUST_DAYS=30
# HttpOnly signed marker binding a trusted device to its browser; override
# only to avoid colliding with another cookie on the host.
#MFA_TRUST_COOKIE_NAME=mfa_trusted_device
# 'Strict' keeps the marker off cross-site navigations.
#MFA_TRUST_COOKIE_SAMESITE=Strict

# `manage.py seed_e2e` creates local end-to-end test data. It REFUSES unless
# --i-know-this-is-a-test-db is passed AND the database looks like a test DB
# (DEBUG=true, sqlite, or a localhost URL), because every row is test data.
#
# No credential literals live in the command: leave these unset and it
# generates each and prints it once; a re-run keeps existing values unless one
# is set explicitly (which rotates it).
#SEED_E2E_SUPERADMIN_PASSWORD=
#SEED_E2E_CUSTOMER_PASSWORD=
#SEED_E2E_TOTP_SECRET=
