# Coverage config for the backend test suite; `coverage report` fails below
# fail_under.
[run]
source = .
# Branch coverage: a decision executed with only one branch taken is still a
# missing path. Line-only coverage reported 100% while guards went untested.
branch = True
omit =
    venv/*
    manage.py
    config/wsgi.py
    config/asgi.py
    */migrations/*
    tests/*
    */tests.py

[report]
fail_under = 90
precision = 2
show_missing = true
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    # Guard below runs in a subprocess (tests/test_settings_security.py), so
    # in-process coverage cannot see it. Quote-agnostic: ruff normalizes
    # strings to double quotes, and a missed pattern becomes a coverage miss.
    if not DEBUG and not os.getenv\(["']DJANGO_SECRET_KEY["']\)

[html]
directory = htmlcov
