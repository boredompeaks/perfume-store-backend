node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
test-results/
playwright-report/
e2e/artifacts/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Tooling / local
.opencode/
.git-frontend-backup/

