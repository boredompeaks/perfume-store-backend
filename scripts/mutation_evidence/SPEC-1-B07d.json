{
  "task": "SPEC-1-B07d",
  "title": "The six mutation figures recorded by the SPEC-1-B07d cycle-2 and cycle-3 rows",
  "note": "Every `find` is hand-written from the committed blob and occurs exactly once in the target file; replay refuses otherwise. Every `expected_failing_tests` name is a hand-written literal, never derived from the run that checks it. `claimed_count` is the audited figure the changelog rows record, not a value recomputed here -- a replay that disagrees is a finding, not a number to adjust.",
  "mutations": [
    {
      "id": "M1",
      "description": "the inclusive boundary in _within_return_window: `now <= anchor + window` becomes `now < anchor + window`",
      "path": "backend/orders/views.py",
      "find": "return now <= _return_window_anchor(order) + timedelta(days=_return_window_days())",
      "replace": "return now < _return_window_anchor(order) + timedelta(days=_return_window_days())",
      "expected_failing_tests": [
        "test_an_eligible_order_inside_the_window_is_accepted",
        "test_the_window_admits_exactly_thirty_days_and_refuses_the_next",
        "test_an_unset_window_admits_thirty_days_and_refuses_thirty_one"
      ],
      "claimed_count": 3,
      "test_scope": ["orders.tests_returns"]
    },
    {
      "id": "M2",
      "description": "the anchor _return_window_anchor falls back from `order.delivered_at or order.created_at` to `order.created_at` alone, dropping the generous delivered reading",
      "path": "backend/orders/views.py",
      "find": "return order.delivered_at or order.created_at",
      "replace": "return order.created_at",
      "expected_failing_tests": [
        "test_the_window_runs_from_delivery_when_the_goods_arrived"
      ],
      "claimed_count": 1,
      "test_scope": ["orders.tests_returns"]
    },
    {
      "id": "M3",
      "description": "SiteSettings.resolved_return_window_days ignores the stored value entirely and always answers the 30-day default, so a configured window is never enforced",
      "path": "backend/ops/models.py",
      "find": "        if self.return_window_days is None:\n            return DEFAULT_RETURN_WINDOW_DAYS\n        return self.return_window_days",
      "replace": "        return DEFAULT_RETURN_WINDOW_DAYS",
      "expected_failing_tests": [
        "test_a_configured_window_is_the_one_that_is_enforced",
        "test_the_window_comes_from_the_singleton_and_from_no_other_row",
        "test_the_gate_reads_the_window_on_every_call_and_not_from_a_cache",
        "test_the_window_is_published_to_the_storefront"
      ],
      "claimed_count": 4,
      "test_scope": ["orders.tests_returns"]
    },
    {
      "id": "M4",
      "description": "the whole window clause of _within_return_window is replaced by `return True`, so every order is inside the window",
      "path": "backend/orders/views.py",
      "find": "    return now <= _return_window_anchor(order) + timedelta(days=_return_window_days())\n",
      "replace": "    return True\n",
      "expected_failing_tests": [
        "test_an_eligible_order_inside_the_window_is_accepted",
        "test_the_window_admits_exactly_thirty_days_and_refuses_the_next",
        "test_an_unset_window_admits_thirty_days_and_refuses_thirty_one",
        "test_a_configured_window_is_the_one_that_is_enforced",
        "test_the_window_runs_from_delivery_when_the_goods_arrived",
        "test_the_gate_reads_the_window_on_every_call_and_not_from_a_cache"
      ],
      "claimed_count": 6,
      "test_scope": []
    },
    {
      "id": "M5",
      "description": "the MaxValueValidator(MAX_RETURN_WINDOW_DAYS) line is deleted from the return_window_days field, so the admin form accepts any positive integer",
      "path": "backend/ops/models.py",
      "find": "        validators=[MaxValueValidator(MAX_RETURN_WINDOW_DAYS)],\n",
      "replace": "",
      "expected_failing_tests": [
        "test_the_window_column_is_bounded_on_both_database_backends",
        "test_the_ceiling_is_the_policy_value_written_out_by_hand"
      ],
      "claimed_count": 3,
      "test_scope": []
    },
    {
      "id": "M6",
      "description": "the shipped default DEFAULT_RETURN_WINDOW_DAYS changes from 30 to 14",
      "path": "backend/ops/models.py",
      "find": "DEFAULT_RETURN_WINDOW_DAYS = 30",
      "replace": "DEFAULT_RETURN_WINDOW_DAYS = 14",
      "expected_failing_tests": [
        "test_the_window_admits_exactly_thirty_days_and_refuses_the_next",
        "test_an_unset_window_admits_thirty_days_and_refuses_thirty_one",
        "test_the_window_field_is_reachable_on_the_admin_form"
      ],
      "claimed_count": 6,
      "test_scope": ["orders.tests_returns"]
    }
  ]
}
