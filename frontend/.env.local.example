# Copy to .env.local and adjust.
# Django API origin — must be in the backend's CORS_ALLOWED_ORIGINS list.
# IMPORTANT: must be SAME-SITE with the frontend origin (e.g. localhost:8000
# with a frontend on localhost:3000 — ports don't split a site). A 127.0.0.1
# mix breaks the session cart: Lax cookies are not sent cross-site.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical site origin (metadata, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— Contact & social (single source: src/lib/site.ts reads these) ———
# Leave any of these empty to hide that channel in the UI.
# NEXT_PUBLIC_* values are baked in at build time: after editing, rebuild.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi! I have a question about a fragrance.
NEXT_PUBLIC_INSTAGRAM_URL=

# Where /admin on the storefront sends visitors (Django admin lives on the
# API origin, not the frontend).
ADMIN_URL=http://127.0.0.1:8000/admin/
