# Copy to .env.local and adjust.
# Django API origin — must be in the backend's CORS_ALLOWED_ORIGINS list.
# IMPORTANT: must be SAME-SITE with the frontend origin (e.g. localhost:8000
# with a frontend on localhost:3000 — ports don't split a site). A 127.0.0.1
# mix breaks the session cart: Lax cookies are not sent cross-site.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical site origin (metadata, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— Brand overrides (single source: src/lib/template.config.ts, read
# through src/lib/site.ts) ———
# Leave empty to keep the default Maison Aurel brand strings.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TAGLINE=
NEXT_PUBLIC_SITE_DESCRIPTION=

# ——— Contact & social (single source: src/lib/template.config.ts) ———
# Leave any of these empty to hide that channel in the UI.
# NEXT_PUBLIC_* values are baked in at build time: after editing, rebuild.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi! I have a question about a fragrance.
NEXT_PUBLIC_INSTAGRAM_URL=

# Absolute origin of the Django admin (scheme + host, no path) — where
# `/admin` on the storefront 307-redirects. NO default: `next build` FAILS if
# unset (fail-if-unset, src/app/admin/page.tsx). Local backend dev: http://localhost:8000
NEXT_PUBLIC_ADMIN_ORIGIN=https://api.boredompeaks.me

# --- Error reporting (src/lib/sentry.ts, P1-3) ---
# Leave empty to disable Sentry entirely: the SDK is not initialised without
# a DSN, and the CSP gains no ingest origin. NEXT_PUBLIC_* values are baked in
# at build time: after editing, rebuild.
NEXT_PUBLIC_SENTRY_DSN=
# Hard per-tab hourly cap on reported events. Defaults to 50 when unset or
# not a positive integer; this is the free-tier quota guard, not a sample rate.
NEXT_PUBLIC_SENTRY_MAX_EVENTS_PER_HOUR=50
