# Copy to .env.local and adjust.
# Django API origin; must be in the backend's CORS_ALLOWED_ORIGINS list and
# SAME-SITE with the frontend (localhost vs 127.0.0.1 breaks the session cart:
# Lax cookies are not sent cross-site).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical site origin (metadata, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand overrides (single source: src/lib/template.config.ts); empty keeps
# the default brand strings.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TAGLINE=
NEXT_PUBLIC_SITE_DESCRIPTION=

# Contact & social (src/lib/template.config.ts); empty hides that channel.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after editing.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi! I have a question about a fragrance.
NEXT_PUBLIC_INSTAGRAM_URL=

# Absolute origin (scheme + host, no path) of the Django admin, where
# `/admin` 307-redirects; `next build` FAILS if unset (src/app/admin/page.tsx).
NEXT_PUBLIC_ADMIN_ORIGIN=https://api.boredompeaks.me

# Error reporting (src/lib/sentry.ts). Empty DSN disables Sentry entirely:
# no SDK init and no CSP ingest origin. Baked in at build time.
NEXT_PUBLIC_SENTRY_DSN=
# Fraction of browser error events sent, 0.0-1.0 (default 1.0). Sampling is
# the spend knob; rate limits live on the Sentry project, not here.
NEXT_PUBLIC_SENTRY_SAMPLE_RATE=1.0
